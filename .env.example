# Crea un bot en https://discord.com/developers/applications
# Guarda el token en un gestor de secretos; no lo publiques ni lo subas a GitHub.
DISCORD_TOKEN=

# Directorio persistente para configuración de bienvenida y despedida.
# En Railway usa /app/data y monta un Volume en /app/data.
DATA_DIR=./data

# Límite de canciones en espera por servidor.
MUSIC_MAX_QUEUE=50
